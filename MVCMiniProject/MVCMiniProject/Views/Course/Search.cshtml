@model CourseSearchPageVM

<div class="menu d-flex flex-column align-items-end justify-content-start text-right menu_mm trans_400">
    <div class="menu_close_container"><div class="menu_close"><div></div><div></div></div></div>
    <div class="search">
        <form asp-controller="Course" asp-action="Search" method="get" class="header_search_form menu_mm">
            <input type="search" name="q" class="search_input menu_mm" placeholder="Search" value="@Model.Query">
            <button type="submit" class="header_search_button d-flex flex-column align-items-center justify-content-center menu_mm">
                <i class="fa fa-search menu_mm" aria-hidden="true"></i>
            </button>
        </form>
    </div>
    <nav class="menu_nav">
        <ul class="menu_mm">
            <li class="menu_mm"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="menu_mm"><a asp-controller="Course" asp-action="Index">Courses</a></li>
            <li class="menu_mm"><a asp-controller="About" asp-action="Index">About</a></li>
        </ul>
    </nav>
</div>

<div class="home">
    <div class="home_background parallax_background parallax-window" data-parallax="scroll" data-image-src="@Url.Content("~/images/courses.jpg")" data-speed="0.8"></div>
    <div class="home_container">
        <div class="container">
            <div class="row">
                <div class="col">
                    <div class="home_content text-center">
                        <div class="home_title">Search</div>
                        <div class="breadcrumbs">
                            <ul>
                                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                                <li><a asp-controller="Course" asp-action="Index">Courses</a></li>
                                <li>Search</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="courses">
    <div class="container">
        <div class="row">
            <div class="col-lg-10 offset-lg-1">
                <div class="section_title text-center">
                    <h2>
                        @if (string.IsNullOrWhiteSpace(Model.Query))
                        {
                            <text>Search courses</text>
                        }
                        else
                        {
                            <text>Results for “@Model.Query”</text>
                        }
                    </h2>
                </div>
            </div>
        </div>

        @if (string.IsNullOrWhiteSpace(Model.Query))
        {
            <div class="row">
                <div class="col">
                    <p class="section_subtitle text-center">Type a course name in the header search and press Enter.</p>
                </div>
            </div>
        }
        else if (Model.Courses == null || !Model.Courses.Any())
        {
            <div class="row">
                <div class="col">
                    <p class="section_subtitle text-center">Bu isimde kurs bulunamadı.</p>
                </div>
            </div>
        }
        else
        {
            <div class="row course_search_page_grid">
                @foreach (var item in Model.Courses)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="course">
                            <a class="course_detail_link" asp-controller="Course" asp-action="Detail" asp-route-id="@item.Id">
                                <div class="course_image">
                                    <img src="~/images/@(string.IsNullOrWhiteSpace(item.Image) ? "courses.jpg" : item.Image)" alt="@item.Title">
                                </div>
                            </a>
                            <div class="course_body">
                                <div class="course_header d-flex flex-row align-items-center justify-content-start">
                                    <div class="course_price ml-auto">Price: <span>$@item.Price</span></div>
                                </div>
                                <div class="course_title">
                                    <h3>
                                        <a class="course_detail_link" asp-controller="Course" asp-action="Detail" asp-route-id="@item.Id">@item.Title</a>
                                    </h3>
                                </div>
                                <div class="course_text">@item.Excerpt</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
