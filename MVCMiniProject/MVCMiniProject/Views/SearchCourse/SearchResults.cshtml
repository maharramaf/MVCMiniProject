 @model IEnumerable<CourseInfoUIVM>

<link rel="stylesheet" type="text/css" href="~/styles/courses.css">
<link rel="stylesheet" type="text/css" href="~/styles/courses_responsive.css">

<div class="menu d-flex flex-column align-items-end justify-content-start text-right menu_mm trans_400">
    <div class="menu_close_container"><div class="menu_close"><div></div><div></div></div></div>
    <div class="search">
        <form asp-controller="SearchCourse" asp-action="Search" method="get" class="header_search_form menu_mm">
            <input type="search" name="searchQuery" class="search_input menu_mm" placeholder="Kurs axtar..." value="@ViewBag.SearchQuery" required="required">
            <button type="submit" class="header_search_button d-flex flex-column align-items-center justify-content-center menu_mm">
                <i class="fa fa-search menu_mm" aria-hidden="true"></i>
            </button>
        </form>
    </div>
    <nav class="menu_nav">
        <ul class="menu_mm">
            <li class="menu_mm"><a asp-controller="Home" asp-action="Index">Ana Səhifə</a></li>
            <li class="menu_mm"><a asp-controller="Course" asp-action="Index">Kurslar</a></li>
            <li class="menu_mm"><a href="#">Müəllimlər</a></li>
            <li class="menu_mm"><a href="#">Tədbirlər</a></li>
            <li class="menu_mm"><a href="#">Blog</a></li>
            <li class="menu_mm"><a href="#">Əlaqə</a></li>
        </ul>
    </nav>
</div>

<!-- Search Results -->
<div class="courses" style="padding: 30px 0 60px 0; background: white;">
    <div class="container">
        <div class="row">
            <div class="col-lg-10 offset-lg-1" style="padding-top: 0;">
                <div class="section_title text-center" style="margin-bottom: 15px;">
                    <h2 style="font-size: 32px; font-weight: 700; color: #1a1a1a;">
                        <i class="fa fa-search" style="color: #ffb606; margin-right: 10px;"></i>Axtarış Nəticələri
                    </h2>
                </div>
                <div class="section_subtitle" style="text-align: center; margin-bottom: 35px; font-size: 16px; color: #666;">
                    "<strong style="color: #ffb606;">@ViewBag.SearchQuery</strong>" üzrə <strong>@ViewBag.ResultCount</strong> kurs tapıldı
                </div>
            </div>
        </div>

        <div class="row courses_row">
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6" style="margin-bottom: 30px;">
                    <div class="course" style="height: 100%; display: flex; flex-direction: column;">
                        <a asp-controller="Detail" asp-action="Index" asp-route-id="@item.Id">
                            <div class="course_image" style="height: 250px; overflow: hidden;">
                                <img src="~/images/@item.MainImage" alt="@item.Title" style="width: 100%; height: 100%; object-fit: cover; cursor: pointer;">
                            </div>
                        </a>
                        <div class="course_body" style="flex: 1; display: flex; flex-direction: column;">
                            <div class="course_header d-flex flex-row align-items-center justify-content-start">
                                @if (item.IsFeature)
                                {
                                    <div class="course_tag"><a href="#">Seçilmiş</a></div>
                                }
                                else if (item.IsNew)
                                {
                                    <div class="course_tag"><a href="#">Yeni</a></div>
                                }
                                <div class="course_price ml-auto">Qiymət: <span>$@item.Price</span></div>
                            </div>
                            <div class="course_title">
                                <h3><a asp-controller="Detail" asp-action="Index" asp-route-id="@item.Id" style="display: block; min-height: 60px;">@item.Title</a></h3>
                            </div>
                            <div class="course_text" style="flex: 1; min-height: 80px; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;">
                                @item.Description
                            </div>
                            <div class="course_footer d-flex align-items-center justify-content-start" style="margin-top: auto;">
                                <div class="course_author_image">
                                    <img src="~/images/@item.TeacherImage" alt="@item.TeacherName" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;">
                                </div>
                                <div class="course_author_name">Müəllim: <a href="#">@item.TeacherName</a></div>
                                <div class="course_sales ml-auto"><span>@item.SalesCount</span> Satış</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Back to Courses Button -->
        <div class="row" style="margin-top: 40px;">
            <div class="col text-center">
                <a asp-controller="Course" asp-action="Index" style="display: inline-block; padding: 15px 40px; background: #ffb606; color: white; border-radius: 50px; text-decoration: none; font-weight: 700; font-size: 16px; transition: all 0.3s; box-shadow: 0 3px 15px rgba(255, 182, 6, 0.3);" onmouseover="this.style.background='#ff9100'; this.style.transform='translateY(-2px)'" onmouseout="this.style.background='#ffb606'; this.style.transform='translateY(0)'">
                    <i class="fa fa-arrow-left"></i> Bütün Kurslara Qayıt
                </a>
            </div>
        </div>
    </div>
</div>
