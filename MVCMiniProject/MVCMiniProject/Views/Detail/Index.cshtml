@model CourseDetailVM

<link rel="stylesheet" type="text/css" href="~/styles/courses.css">
<link rel="stylesheet" type="text/css" href="~/styles/courses_responsive.css">

<style>
    .course_detail_section {
        padding: 80px 0;
        background: #f8f9fa;
    }

    .course_detail_container {
        background: white;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .course_main_image {
        width: 100%;
        height: 450px;
        object-fit: cover;
        border-bottom: 5px solid #ffb606;
    }

    .course_content_wrapper {
        padding: 40px;
    }

    .course_title_main {
        font-size: 36px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 20px;
        line-height: 1.3;
    }

    .course_meta_info {
        display: flex;
        flex-wrap: wrap;
        gap: 30px;
        margin-bottom: 30px;
        padding-bottom: 30px;
        border-bottom: 2px solid #f0f0f0;
    }

    .meta_item {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .meta_item i {
        color: #ffb606;
        font-size: 20px;
    }

    .meta_label {
        font-weight: 600;
        color: #666;
        font-size: 14px;
    }

    .meta_value {
        font-weight: 700;
        color: #1a1a1a;
        font-size: 16px;
    }

    .teacher_info_section {
        background: #fff8e6;
        padding: 25px;
        border-radius: 10px;
        margin-bottom: 30px;
        display: flex;
        align-items: center;
        gap: 20px;
        border: 2px solid #ffb606;
    }

    .teacher_image_detail {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #ffb606;
    }

    .teacher_details {
        flex: 1;
    }

    .teacher_label {
        font-size: 14px;
        color: #666;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
    }

    .teacher_name {
        font-size: 24px;
        font-weight: 700;
        color: #1a1a1a;
        margin-top: 5px;
    }

    .course_description_section {
        padding: 30px;
        background: #f9f9f9;
        border-radius: 10px;
        margin-top: 20px;
    }

    .section_title {
        font-size: 24px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 20px;
        border-bottom: 3px solid #ffb606;
        padding-bottom: 10px;
    }

    .course_description_text {
        font-size: 16px;
        line-height: 1.8;
        color: #555;
        text-align: justify;
    }


    .breadcrumbs_container {
        padding: 30px 0;
        background: #f8f9fa;
    }

    .breadcrumbs ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        gap: 15px;
    }

    .breadcrumbs li {
        display: flex;
        align-items: center;
        color: #666;
        font-size: 14px;
    }

    .breadcrumbs li::after {
        content: ">";
        margin-left: 15px;
        color: #ffb606;
    }

    .breadcrumbs li:last-child::after {
        display: none;
    }

    .breadcrumbs a {
        color: #666;
        text-decoration: none;
        transition: color 0.3s;
    }

    .breadcrumbs a:hover {
        color: #ffb606;
    }

    @@media (max-width: 991px) {
        .course_title_main {
            font-size: 28px;
        }
        
        .course_content_wrapper {
            padding: 25px;
        }
    }
</style>

<div class="menu d-flex flex-column align-items-end justify-content-start text-right menu_mm trans_400">
    <div class="menu_close_container"><div class="menu_close"><div></div><div></div></div></div>
    <div class="search">
        <form action="#" class="header_search_form menu_mm">
            <input type="search" class="search_input menu_mm" placeholder="Search" required="required">
            <button class="header_search_button d-flex flex-column align-items-center justify-content-center menu_mm">
                <i class="fa fa-search menu_mm" aria-hidden="true"></i>
            </button>
        </form>
    </div>
    <nav class="menu_nav">
        <ul class="menu_mm">
            <li class="menu_mm"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="menu_mm"><a asp-controller="Course" asp-action="Index">Courses</a></li>
            <li class="menu_mm"><a href="#">Instructors</a></li>
            <li class="menu_mm"><a href="#">Events</a></li>
            <li class="menu_mm"><a href="#">Blog</a></li>
            <li class="menu_mm"><a href="#">Contact</a></li>
        </ul>
    </nav>
    <div class="menu_extra">
        <div class="menu_phone"><span class="menu_title">phone:</span>(009) 35475 6688933 32</div>
        <div class="menu_social">
            <span class="menu_title">follow us</span>
            <ul>
                <li><a href="#"><i class="fa fa-pinterest" aria-hidden="true"></i></a></li>
                <li><a href="#"><i class="fa fa-facebook" aria-hidden="true"></i></a></li>
                <li><a href="#"><i class="fa fa-instagram" aria-hidden="true"></i></a></li>
                <li><a href="#"><i class="fa fa-twitter" aria-hidden="true"></i></a></li>
            </ul>
        </div>
    </div>
</div>

<!-- Home -->
<div class="home">
    <div class="home_background" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 60px 0;">
        <div class="container">
            <div class="row">
                <div class="col">
                    <div class="home_content text-center" style="color: white;">
                        <div class="home_subtitle" style="font-size: 18px; margin-bottom: 20px; opacity: 0.9; line-height: 1.6; max-width: 800px; margin-left: auto; margin-right: auto;">@Model.Description</div>
                        <div class="home_info" style="display: flex; justify-content: center; gap: 50px; flex-wrap: wrap; margin-top: 30px;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <i class="fa fa-user-circle" style="font-size: 28px;"></i>
                                <div style="text-align: left;">
                                    <div style="font-size: 13px; opacity: 0.8; margin-bottom: 3px;">Müəllim</div>
                                    <div style="font-size: 18px; font-weight: 700;">@Model.TeacherName</div>
                                </div>
                            </div>
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <i class="fa fa-users" style="font-size: 28px;"></i>
                                <div style="text-align: left;">
                                    <div style="font-size: 13px; opacity: 0.8; margin-bottom: 3px;">Tələbələr</div>
                                    <div style="font-size: 18px; font-weight: 700;">@Model.SalesCount nəfər</div>
                                </div>
                            </div>
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <i class="fa fa-usd" style="font-size: 28px;"></i>
                                <div style="text-align: left;">
                                    <div style="font-size: 13px; opacity: 0.8; margin-bottom: 3px;">Qiymət</div>
                                    <div style="font-size: 18px; font-weight: 700;">$@Model.Price</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="breadcrumbs_container">
        <div class="container">
            <div class="row">
                <div class="col">
                    <div class="breadcrumbs">
                        <ul>
                            <li><a asp-controller="Home" asp-action="Index">Ana Səhifə</a></li>
                            <li><a asp-controller="Course" asp-action="Index">Kurslar</a></li>
                            <li>@Model.Title</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Course -->
<div class="course">
    <div class="container">
        <div class="row">
            
            <!-- Course -->
            <div class="col-lg-8">
                
                <div class="course_container">
                    
                    <!-- Course Image -->
                    <div class="course_image" style="margin-bottom: 30px;">
                        <img src="~/images/@Model.MainImage" alt="@Model.Title" style="width: 100%; max-width: 600px; display: block; margin: 0 auto; border-radius: 10px; box-shadow: 0 3px 15px rgba(0,0,0,0.1);">
                    </div>

                    <!-- Course Description -->
                    <div class="course_description_section">
                        <h3 class="section_title">Kurs Haqqında</h3>
                        <p class="course_description_text">@Model.Description</p>
                    </div>
                </div>
            </div>

            <!-- Course Sidebar -->
            <div class="col-lg-4">
                <div class="sidebar">

                    <!-- Feature -->
                    <div class="sidebar_section">
                        <div class="sidebar_section_title" style="text-align: center; font-size: 22px; margin-bottom: 25px; color: #1a1a1a; font-weight: 700;">Kurs Məlumatı</div>
                        <div class="sidebar_feature" style="background: #fff; padding: 30px; border-radius: 10px; box-shadow: 0 3px 15px rgba(0,0,0,0.1);">

                            <!-- Price -->
                            <div class="course_price" style="text-align: center; margin-bottom: 25px; padding-bottom: 25px; border-bottom: 2px solid #f0f0f0;">
                                <div class="price_title" style="font-size: 18px; margin-bottom: 8px; color: #666; font-weight: 600;">Qiymət</div>
                                <div class="price_num" style="font-size: 52px; font-weight: 700; color: #ffb606;">${@Model.Price}</div>
                            </div>

                            <!-- Status Feature -->
                            <div class="feature" style="text-align: center; margin-bottom: 20px; padding: 15px; background: #f9f9f9; border-radius: 8px;">
                                <div style="display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 8px;">
                                    <i class="fa fa-graduation-cap" aria-hidden="true" style="font-size: 22px; color: #ffb606;"></i>
                                    <span style="font-size: 16px; font-weight: 600; color: #666;">Status:</span>
                                </div>
                                <div class="feature_text">
                                    @if (Model.IsFeature)
                                    {
                                        <span class="badge badge-warning" style="font-size: 15px; padding: 8px 18px; font-weight: 600;">Seçilmiş</span>
                                    }
                                    @if (Model.IsNew)
                                    {
                                        <span class="badge badge-success" style="font-size: 15px; padding: 8px 18px; font-weight: 600;">Yeni</span>
                                    }
                                    @if (!Model.IsFeature && !Model.IsNew)
                                    {
                                        <span class="badge badge-info" style="font-size: 15px; padding: 8px 18px; font-weight: 600;">Aktiv</span>
                                    }
                                </div>
                            </div>

                            <!-- Students Feature -->
                            <div class="feature" style="text-align: center; margin-bottom: 25px; padding: 15px; background: #f9f9f9; border-radius: 8px;">
                                <div style="display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 8px;">
                                    <i class="fa fa-users" aria-hidden="true" style="font-size: 22px; color: #ffb606;"></i>
                                    <span style="font-size: 16px; font-weight: 600; color: #666;">Tələbələr:</span>
                                </div>
                                <div class="feature_text" style="font-size: 24px; font-weight: 700; color: #1a1a1a;">@Model.SalesCount nəfər</div>
                            </div>

                            <!-- Enroll Button -->
                            <div class="enroll_button" style="text-align: center; margin-top: 25px;">
                                <a href="#" style="display: inline-block; font-size: 18px; padding: 15px 50px; background: #ffb606; color: white; border-radius: 50px; text-decoration: none; font-weight: 700; transition: all 0.3s; box-shadow: 0 4px 15px rgba(255, 182, 6, 0.3);" onmouseover="this.style.background='#ff9100'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 20px rgba(255, 182, 6, 0.4)'" onmouseout="this.style.background='#ffb606'; this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(255, 182, 6, 0.3)'">
                                    <i class="fa fa-check-circle"></i> Kursa Yazıl
                                </a>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .course_gallery_image {
        border-radius: 5px;
        overflow: hidden;
    }
    .course_gallery_image img {
        width: 100%;
        height: auto;
        transition: transform 0.3s ease;
    }
    .course_gallery_image:hover img {
        transform: scale(1.05);
    }
    .badge {
        padding: 5px 10px;
        font-size: 12px;
    }
</style>
