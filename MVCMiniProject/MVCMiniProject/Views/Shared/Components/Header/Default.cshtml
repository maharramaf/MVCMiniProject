@model Dictionary<string, string>
<header class="header">

    <div class="top_bar">
        <div class="top_bar_container">
            <div class="container">
                <div class="row">
                    <div class="col">
                        <div class="top_bar_content d-flex flex-row align-items-center justify-content-start">
                            <ul class="top_bar_contact_list">
                                <li><div class="question">Have any questions?</div></li>
                                <li>
                                    <div>@Model["Phone"]</div>
                                </li>
                                <li>
                                    <div><a href="~/https://preview.colorlib.com/cdn-cgi/l/email-protection" class="__cf_email__" data-cfemail="0960676f66496c65686c7b677d6c647965687d6c276a6664">@Model["Email"]</a></div>
                                </li>
                            </ul>
                            <div class="top_bar_login ml-auto">
                                <ul>
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        @if (User.IsInRole("admin") || User.IsInRole("superadmin"))
                                        {
                                            <li><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                                        }
                                        <li><a asp-controller="Account" asp-action="Profile">@User.Identity.Name</a></li>
                                        <li>
                                            <form asp-controller="Account" asp-action="Logout" asp-area="" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="top_bar_logout">Logout</button>
                                            </form>
                                        </li>
                                    }
                                    else
                                    {
                                        <li><a asp-controller="Account" asp-action="Register">Register</a></li>
                                        <li><a asp-controller="Account" asp-action="Login">Login</a></li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="header_container">
        <div class="container">
            <div class="row">
                <div class="col">
                    <div class="header_content d-flex flex-row align-items-center justify-content-start">
                        <div class="logo_container">
                            <a href="~/#">
                                <div class="logo_content d-flex flex-row align-items-end justify-content-start">
                                    <div class="logo_img"><img src="images/@Model["Logo"]" alt=""></div>
                                    <div class="logo_text">@Model["LogoText"]</div>
                                </div>
                            </a>
                        </div>
                        <nav class="main_nav_contaner ml-auto">
                            <ul class="main_nav">
                                <li class="active"><a asp-controller="Home" asp-action="Index">home</a></li>
                                <li><a asp-controller="About" asp-action="Index">about us</a></li>
                                <li><a asp-controller="Course" asp-action="Index">courses</a></li>
                                <li><a href="~/news.html">news</a></li>
                                <li><a href="~/contact.html">contact</a></li>
                            </ul>
                            <div class="search_button"><i class="fa fa-search" aria-hidden="true"></i></div>

                            <div class="hamburger menu_mm">
                                <i class="fa fa-bars menu_mm" aria-hidden="true"></i>
                            </div>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="header_search_container">
        <div class="container">
            <div class="row">
                <div class="col">
                    <div class="header_search_content d-flex flex-row align-items-center justify-content-end">
                        <form asp-controller="Course" asp-action="Search" method="get" class="header_search_form js-course-search" autocomplete="off">
                            <input type="search" name="q" class="search_input" placeholder="Search..." autocomplete="off">
                            <div class="course_search_dropdown" hidden></div>
                            <button type="submit" class="header_search_button d-flex flex-column align-items-center justify-content-center">
                                <i class="fa fa-search" aria-hidden="true"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>