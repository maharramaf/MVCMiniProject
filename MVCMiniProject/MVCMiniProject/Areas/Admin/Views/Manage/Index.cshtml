@using MVCMiniProject.Admin
@model AdminListVM
@{
    ViewData["Title"] = Model.Entity.PluralName;
    string SortUrl(string field)
    {
        var nextDir = Model.Sort == field && Model.Dir == "asc" ? "desc" : "asc";
        var query = $"search={Uri.EscapeDataString(Model.Search ?? string.Empty)}&sort={field}&dir={nextDir}&page=1";
        foreach (var filter in Model.Filters)
        {
            query += $"&{filter.Key}={Uri.EscapeDataString(filter.Value)}";
        }
        return $"/admin/{Model.Entity.Slug}?{query}";
    }
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <form method="get" class="d-flex flex-wrap gap-2 flex-grow-1">
        <input type="hidden" name="sort" value="@Model.Sort" />
        <input type="hidden" name="dir" value="@Model.Dir" />
        <input type="text" name="search" value="@Model.Search" class="form-control" style="max-width:260px;" placeholder="Search @Model.Entity.PluralName.ToLower()">
        @foreach (var field in Model.Entity.Fields.Where(f => f.Filterable))
        {
            var selected = Model.Filters.TryGetValue(field.Name, out var current) ? current : "";
            if (field.Kind == AdminFieldKind.Boolean || Model.FilterOptions.ContainsKey(field.Name))
            {
                <select name="@field.Name" class="form-select" style="max-width:180px;">
                    <option value="">All @field.Label</option>
                    @if (field.Kind == AdminFieldKind.Boolean)
                    {
                        if (selected == "true") { <option value="true" selected>Yes</option> } else { <option value="true">Yes</option> }
                        if (selected == "false") { <option value="false" selected>No</option> } else { <option value="false">No</option> }
                    }
                    else if (Model.FilterOptions.TryGetValue(field.Name, out var options))
                    {
                        foreach (var option in options)
                        {
                            if (selected == option.Value) { <option value="@option.Value" selected>@option.Text</option> }
                            else { <option value="@option.Value">@option.Text</option> }
                        }
                    }
                </select>
            }
            else
            {
                <input type="text" name="@field.Name" value="@selected" class="form-control" style="max-width:160px;" placeholder="@field.Label">
            }
        }
        <button class="btn btn-dark" type="submit">Apply</button>
        <a class="btn btn-outline-secondary" href="/admin/@Model.Entity.Slug">Reset</a>
    </form>
    <a class="btn btn-success" href="/admin/@Model.Entity.Slug/create">
        <i class="fa-solid fa-plus"></i> Add New
    </a>
</div>

@if (!Model.Rows.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center text-muted py-5">No records found.</div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 admin-table">
                <thead class="table-dark">
                    <tr>
                        <th><a class="text-white text-decoration-none" href="@SortUrl("Id")">ID</a></th>
                        @foreach (var field in Model.Entity.Fields.Where(f => f.ShowInList))
                        {
                            <th>
                                @if (field.Sortable)
                                {
                                    <a class="text-white text-decoration-none" href="@SortUrl(field.Name)">@field.Label</a>
                                }
                                else
                                {
                                    @field.Label
                                }
                            </th>
                        }
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>@row.Id</td>
                            @foreach (var field in Model.Entity.Fields.Where(f => f.ShowInList))
                            {
                                var value = row.Values.TryGetValue(field.Name, out var cell) ? cell : "-";
                                <td>
                                    @if (field.Kind == AdminFieldKind.Image && !string.IsNullOrWhiteSpace(value) && value != "-")
                                    {
                                        <img src="~/images/@value" alt="">
                                    }
                                    else
                                    {
                                        @value
                                    }
                                </td>
                            }
                            <td class="text-nowrap">
                                <a class="btn btn-info btn-sm text-white" href="/admin/@Model.Entity.Slug/@row.Id">View</a>
                                <a class="btn btn-warning btn-sm" href="/admin/@Model.Entity.Slug/@row.Id/edit">Edit</a>
                                <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@row.Id" data-title="@row.Title">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination">
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    var query = $"search={Uri.EscapeDataString(Model.Search ?? string.Empty)}&sort={Model.Sort}&dir={Model.Dir}&page={i}";
                    foreach (var filter in Model.Filters)
                    {
                        query += $"&{filter.Key}={Uri.EscapeDataString(filter.Value)}";
                    }
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" href="/admin/@Model.Entity.Slug?@query">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this item? <strong id="deleteTitle"></strong>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" class="admin-loading-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("deleteModal").addEventListener("show.bs.modal", function (event) {
            const button = event.relatedTarget;
            document.getElementById("deleteTitle").textContent = button.getAttribute("data-title");
            document.getElementById("deleteForm").action = "/admin/@Model.Entity.Slug/" + button.getAttribute("data-id") + "/delete";
        });
    </script>
}
