@model TeacherUpdateVM
@{ViewData["Title"] = "Müəllim Redaktə";}
<!DOCTYPE html>
<html lang="az">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></head>
<body><div class="container-fluid"><div class="row">
            <nav class="col-md-2 d-md-block bg-dark sidebar vh-100"><div class="position-sticky pt-3"><h4 class="text-white text-center mb-4">Admin Panel</h4><ul class="nav flex-column">
                        <li class="nav-item"><a class="nav-link text-white" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fas fa-home"></i> Ana Səhifə</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-area="Admin" asp-controller="Slider" asp-action="Index"><i class="fas fa-images"></i> Sliderlər</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-area="Admin" asp-controller="Course" asp-action="Index"><i class="fas fa-book"></i> Kurslar</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-area="Admin" asp-controller="Event" asp-action="Index"><i class="fas fa-calendar"></i> Tədbirlər</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-area="Admin" asp-controller="News" asp-action="Index"><i class="fas fa-newspaper"></i> Xəbərlər</a></li>
                        <li class="nav-item"><a class="nav-link text-white active" asp-area="Admin" asp-controller="Teacher" asp-action="Index"><i class="fas fa-chalkboard-teacher"></i> Müəllimlər</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-area="Admin" asp-controller="Icon" asp-action="Index"><i class="fas fa-icons"></i> İconlar</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-area="Admin" asp-controller="Setting" asp-action="Index"><i class="fas fa-cog"></i> Tənzimləmələr</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="/"><i class="fas fa-globe"></i> Sayta Get</a></li>
                    </ul></div></nav>
            <main class="col-md-10 ms-sm-auto px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Müəllim Redaktə Et</h1><a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Geriyə</a></div>
                <div class="row"><div class="col-md-8"><form asp-action="Update" method="post" enctype="multipart/form-data">
                            <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="ExistingImage" />
                            <div class="mb-3"><label asp-for="FullName" class="form-label">Ad Soyad</label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span></div>
                            <div class="mb-3">
                                <label asp-for="PositionId" class="form-label">Vəzifə</label>
                                <div class="input-group">
                                    <select asp-for="PositionId" asp-items="@ViewBag.Positions" class="form-select" id="positionSelect"><option value="">Seçin...</option></select>
                                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addPositionModal"><i class="fas fa-plus"></i> Yeni</button>
                                </div>
                                <span asp-validation-for="PositionId" class="text-danger"></span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.ExistingImage))
                            {<div class="mb-3"><label class="form-label">Mövcud Şəkil</label><div><img src="~/images/@Model.ExistingImage" alt="Existing" style="width: 150px; height: 150px; object-fit: cover; border-radius: 50%;"></div></div>}
                            <div class="mb-3"><label asp-for="Image" class="form-label">Yeni Şəkil (ixtiyari)</label><input asp-for="Image" type="file" class="form-control" accept="image/*" /><span asp-validation-for="Image" class="text-danger"></span><small class="text-muted">Yeni şəkil seçməsəniz, mövcud şəkil saxlanacaq</small></div>
                            <div class="mb-3"><button type="submit" class="btn btn-warning"><i class="fas fa-save"></i> Yenilə</button>
                                <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-times"></i> Ləğv Et</a></div>
                        </form></div></div>

            <div class="modal fade" id="addPositionModal" tabindex="-1">
                <div class="modal-dialog"><div class="modal-content">
                        <div class="modal-header"><h5 class="modal-title">Yeni Vəzifə Əlavə Et</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                        <div class="modal-body">
                            <div class="mb-3"><label for="newPositionName" class="form-label">Vəzifə Adı</label><input type="text" class="form-control" id="newPositionName" placeholder="Məsələn: Baş Müəllim" /></div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Ləğv Et</button>
                            <button type="button" class="btn btn-success" onclick="addPosition()"><i class="fas fa-save"></i> Əlavə Et</button>
                        </div>
                    </div></div>
            </div>

            <script>
                function addPosition() {
                    const positionName = document.getElementById('newPositionName').value;
                    if (!positionName) {
                        alert('Vəzifə adı daxil edin!');
                        return;
                    }
                    fetch('/Admin/Position/CreateAjax', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ Name: positionName })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            const select = document.getElementById('positionSelect');
                            const option = new Option(data.name, data.id, true, true);
                            select.add(option);
                            bootstrap.Modal.getInstance(document.getElementById('addPositionModal')).hide();
                            document.getElementById('newPositionName').value = '';
                        } else {
                            alert('Xəta baş verdi!');
                        }
                    });
                }
            </script>
            </main></div></div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script></body></html>
