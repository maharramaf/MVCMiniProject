@{
    ViewData["Title"] = "Admin Panel";
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 d-md-block bg-dark sidebar vh-100">
                <div class="position-sticky pt-3">
                    <h4 class="text-white text-center mb-4">Admin Panel</h4>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link text-white active" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                <i class="fas fa-home"></i> Ana Səhifə
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="Admin" asp-controller="Slider" asp-action="Index">
                                <i class="fas fa-images"></i> Sliderlər
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="Admin" asp-controller="Course" asp-action="Index">
                                <i class="fas fa-book"></i> Kurslar
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="Admin" asp-controller="Event" asp-action="Index">
                                <i class="fas fa-calendar"></i> Tədbirlər
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="Admin" asp-controller="News" asp-action="Index">
                                <i class="fas fa-newspaper"></i> Xəbərlər
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="Admin" asp-controller="Teacher" asp-action="Index">
                                <i class="fas fa-chalkboard-teacher"></i> Müəllimlər
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="Admin" asp-controller="Icon" asp-action="Index">
                                <i class="fas fa-icons"></i> İconlar
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="Admin" asp-controller="Setting" asp-action="Index">
                                <i class="fas fa-cog"></i> Tənzimləmələr
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/">
                                <i class="fas fa-globe"></i> Sayta Get
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <main class="col-md-10 ms-sm-auto px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Dashboard</h1>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-4">
                        <div class="card text-white bg-primary">
                            <div class="card-body">
                                <h5 class="card-title"><i class="fas fa-images"></i> Sliderlər</h5>
                                <p class="card-text">Slider idarəsi</p>
                                <a asp-area="Admin" asp-controller="Slider" asp-action="Index" class="btn btn-light">İdarə Et</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-4">
                        <div class="card text-white bg-success">
                            <div class="card-body">
                                <h5 class="card-title"><i class="fas fa-book"></i> Kurslar</h5>
                                <p class="card-text">Kurs idarəsi</p>
                                <a asp-area="Admin" asp-controller="Course" asp-action="Index" class="btn btn-light">İdarə Et</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-4">
                        <div class="card text-white bg-warning">
                            <div class="card-body">
                                <h5 class="card-title"><i class="fas fa-calendar"></i> Tədbirlər</h5>
                                <p class="card-text">Tədbir idarəsi</p>
                                <a asp-area="Admin" asp-controller="Event" asp-action="Index" class="btn btn-light">İdarə Et</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-4">
                        <div class="card text-white bg-info">
                            <div class="card-body">
                                <h5 class="card-title"><i class="fas fa-newspaper"></i> Xəbərlər</h5>
                                <p class="card-text">Xəbər idarəsi</p>
                                <a asp-area="Admin" asp-controller="News" asp-action="Index" class="btn btn-light">İdarə Et</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-4">
                        <div class="card text-white bg-danger">
                            <div class="card-body">
                                <h5 class="card-title"><i class="fas fa-chalkboard-teacher"></i> Müəllimlər</h5>
                                <p class="card-text">Müəllim idarəsi</p>
                                <a asp-area="Admin" asp-controller="Teacher" asp-action="Index" class="btn btn-light">İdarə Et</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-4">
                        <div class="card text-white bg-secondary">
                            <div class="card-body">
                                <h5 class="card-title"><i class="fas fa-icons"></i> İconlar</h5>
                                <p class="card-text">Icon idarəsi</p>
                                <a asp-area="Admin" asp-controller="Icon" asp-action="Index" class="btn btn-light">İdarə Et</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-4">
                        <div class="card text-white bg-dark">
                            <div class="card-body">
                                <h5 class="card-title"><i class="fas fa-cog"></i> Tənzimləmələr</h5>
                                <p class="card-text">Setting idarəsi</p>
                                <a asp-area="Admin" asp-controller="Setting" asp-action="Index" class="btn btn-light">İdarə Et</a>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
