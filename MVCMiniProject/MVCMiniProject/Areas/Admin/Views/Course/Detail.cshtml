@model CourseInfo

@{
    ViewData["Title"] = "Kurs Detalları";
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 d-md-block bg-dark sidebar vh-100">
                <div class="position-sticky pt-3">
                    <h4 class="text-white text-center mb-4">Admin Panel</h4>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                <i class="fas fa-home"></i> Ana Səhifə
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="Admin" asp-controller="Slider" asp-action="Index">
                                <i class="fas fa-images"></i> Sliderlər
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white active" asp-area="Admin" asp-controller="Course" asp-action="Index">
                                <i class="fas fa-book"></i> Kurslar
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="Admin" asp-controller="Event" asp-action="Index">
                                <i class="fas fa-calendar"></i> Tədbirlər
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/">
                                <i class="fas fa-globe"></i> Sayta Get
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <main class="col-md-10 ms-sm-auto px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Kurs Detalları</h1>
                    <div>
                        <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning">
                            Edit
                        </a>
                        <a asp-action="Index" class="btn btn-secondary">
                            Geriyə
                        </a>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-8">
                        <div class="card shadow-sm">
                            <div class="card-header bg-success text-white">
                                <h5 class="mb-0">Kurs Məlumatları</h5>
                            </div>
                            <div class="card-body">
                                @{
                                    var mainImage = Model.CourseImages?.FirstOrDefault(img => img.IsMain);
                                }
                                @if (mainImage != null)
                                {
                                    <div class="row mb-4">
                                        <div class="col-md-12">
                                            <img src="~/images/@mainImage.Name" alt="@Model.Title" class="img-fluid rounded" style="width: 100%; height: 400px; object-fit: cover;">
                                        </div>
                                    </div>
                                }

                                <div class="row mb-4">
                                    <div class="col-md-6 mb-3">
                                        <div class="card">
                                            <img src="~/images/teacher_1.jpg" alt="Gallery 1" class="card-img-top" style="height: 200px; object-fit: cover;">
                                            <div class="card-body">
                                                <h6 class="card-title">Əlavə Şəkil 1</h6>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <div class="card">
                                            <img src="~/images/news_2.jpg" alt="Gallery 2" class="card-img-top" style="height: 200px; object-fit: cover;">
                                            <div class="card-body">
                                                <h6 class="card-title">Əlavə Şəkil 2</h6>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <hr class="my-4">

                                <h5 class="mb-3">Məlumatlar</h5>
                                <table class="table table-striped table-bordered">
                                    <tbody>
                                        <tr>
                                            <th style="width: 200px;" class="bg-light">ID</th>
                                            <td>@Model.Id</td>
                                        </tr>
                                        <tr>
                                            <th class="bg-light">Başlıq</th>
                                            <td><strong>@Model.Title</strong></td>
                                        </tr>
                                        <tr>
                                            <th class="bg-light">Açıqlama</th>
                                            <td>@Model.Description</td>
                                        </tr>
                                        <tr>
                                            <th class="bg-light">Qiymət</th>
                                            <td><span class="badge bg-success fs-6">${@Model.Price}</span></td>
                                        </tr>
                                        <tr>
                                            <th class="bg-light">Satış Sayı</th>
                                            <td><span class="badge bg-info fs-6">@Model.SalesCount</span></td>
                                        </tr>
                                        <tr>
                                            <th class="bg-light">Müəllim</th>
                                            <td>@(Model.Teacher?.FullName ?? "Yoxdur")</td>
                                        </tr>
                                        <tr>
                                            <th class="bg-light">Status</th>
                                            <td>
                                                @if (Model.IsFeature)
                                                {
                                                    <span class="badge bg-primary">Seçilmiş</span>
                                                }
                                                @if (Model.IsNew)
                                                {
                                                    <span class="badge bg-success">Yeni</span>
                                                }
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                                <div class="mt-4 d-flex gap-2">
                                    <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning">
                                        Edit
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline;">
                                        <button type="submit" class="btn btn-danger" onclick="return confirm('Silmək istədiyinizə əminsiniz?')">
                                            Delete
                                        </button>
                                    </form>
                                    <a asp-action="Index" class="btn btn-secondary">
                                        Siyahıya Qayıt
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
