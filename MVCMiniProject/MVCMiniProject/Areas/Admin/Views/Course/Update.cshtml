@model CourseUpdateVM

@{
    ViewData["Title"] = "Kurs Redaktə";
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 d-md-block bg-dark sidebar vh-100">
                <div class="position-sticky pt-3">
                    <h4 class="text-white text-center mb-4">Admin Panel</h4>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                <i class="fas fa-home"></i> Ana Səhifə
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="Admin" asp-controller="Slider" asp-action="Index">
                                <i class="fas fa-images"></i> Sliderlər
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white active" asp-area="Admin" asp-controller="Course" asp-action="Index">
                                <i class="fas fa-book"></i> Kurslar
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="Admin" asp-controller="Event" asp-action="Index">
                                <i class="fas fa-calendar"></i> Tədbirlər
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/">
                                <i class="fas fa-globe"></i> Sayta Get
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <main class="col-md-10 ms-sm-auto px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Kurs Redaktə Et</h1>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Geriyə
                    </a>
                </div>

                <div class="row">
                    <div class="col-md-8">
                        <form asp-action="Update" method="post" enctype="multipart/form-data">
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="ExistingImage" />

                            <div class="mb-3">
                                <label asp-for="Title" class="form-label">Başlıq</label>
                                <input asp-for="Title" class="form-control" />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">Açıqlama</label>
                                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Price" class="form-label">Qiymət ($)</label>
                                    <input asp-for="Price" type="number" step="0.01" class="form-control" />
                                    <span asp-validation-for="Price" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="SalesCount" class="form-label">Satış Sayı</label>
                                    <input asp-for="SalesCount" type="number" class="form-control" />
                                    <span asp-validation-for="SalesCount" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="TeacherId" class="form-label">Müəllim</label>
                                <div class="input-group">
                                    <select asp-for="TeacherId" asp-items="@ViewBag.Teachers" class="form-select" id="teacherSelect">
                                        <option value="">Seçin...</option>
                                    </select>
                                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addTeacherModal">
                                        <i class="fas fa-plus"></i> Yeni
                                    </button>
                                </div>
                                <span asp-validation-for="TeacherId" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <div class="form-check">
                                    <input asp-for="IsFeature" class="form-check-input" type="checkbox" />
                                    <label asp-for="IsFeature" class="form-check-label">Seçilmiş Kurs</label>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="form-check">
                                    <input asp-for="IsNew" class="form-check-input" type="checkbox" />
                                    <label asp-for="IsNew" class="form-check-label">Yeni Kurs</label>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.ExistingImage))
                            {
                                <div class="mb-3">
                                    <label class="form-label">Mövcud Şəkil</label>
                                    <div>
                                        <img src="~/images/@Model.ExistingImage" alt="Existing" style="width: 200px; height: 120px; object-fit: cover; border-radius: 5px;">
                                    </div>
                                </div>
                            }

                            <div class="mb-3">
                                <label asp-for="MainImage" class="form-label">Yeni Şəkil (ixtiyari)</label>
                                <input asp-for="MainImage" type="file" class="form-control" accept="image/*" />
                                <span asp-validation-for="MainImage" class="text-danger"></span>
                                <small class="text-muted">Yeni şəkil seçməsəniz, mövcud şəkil saxlanacaq</small>
                            </div>

                            <div class="mb-3">
                                <button type="submit" class="btn btn-warning">
                                    <i class="fas fa-save"></i> Yenilə
                                </button>
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="fas fa-times"></i> Ləğv Et
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <div class="modal fade" id="addTeacherModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Yeni Müəllim Əlavə Et</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="newTeacherName" class="form-label">Ad Soyad</label>
                        <input type="text" class="form-control" id="newTeacherName" placeholder="Məsələn: Əli Məmmədov" />
                    </div>
                    <div class="mb-3">
                        <label for="newTeacherImage" class="form-label">Şəkil</label>
                        <input type="file" class="form-control" id="newTeacherImage" accept="image/*" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Ləğv Et</button>
                    <button type="button" class="btn btn-success" onclick="addTeacher()">
                        <i class="fas fa-save"></i> Əlavə Et
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function addTeacher() {
            const teacherName = document.getElementById('newTeacherName').value;
            const teacherImage = document.getElementById('newTeacherImage').files[0];
            
            if (!teacherName || !teacherImage) {
                alert('Ad Soyad və Şəkil mütləqdir!');
                return;
            }

            const formData = new FormData();
            formData.append('FullName', teacherName);
            formData.append('Image', teacherImage);

            fetch('/Admin/Teacher/CreateAjax', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const select = document.getElementById('teacherSelect');
                    const option = new Option(data.fullName, data.id, true, true);
                    select.add(option);
                    bootstrap.Modal.getInstance(document.getElementById('addTeacherModal')).hide();
                    document.getElementById('newTeacherName').value = '';
                    document.getElementById('newTeacherImage').value = '';
                } else {
                    alert('Xəta baş verdi!');
                }
            });
        }
    </script>
</body>
</html>
