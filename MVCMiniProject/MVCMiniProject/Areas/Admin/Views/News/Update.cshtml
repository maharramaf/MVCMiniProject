@model NewsUpdateVM
@{ViewData["Title"] = "Xəbər Redaktə";}
<!DOCTYPE html>
<html lang="az">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></head>
<body><div class="container-fluid"><div class="row">
            <nav class="col-md-2 d-md-block bg-dark sidebar vh-100"><div class="position-sticky pt-3"><h4 class="text-white text-center mb-4">Admin Panel</h4><ul class="nav flex-column">
                        <li class="nav-item"><a class="nav-link text-white" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fas fa-home"></i> Ana Səhifə</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-area="Admin" asp-controller="Slider" asp-action="Index"><i class="fas fa-images"></i> Sliderlər</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-area="Admin" asp-controller="Course" asp-action="Index"><i class="fas fa-book"></i> Kurslar</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-area="Admin" asp-controller="Event" asp-action="Index"><i class="fas fa-calendar"></i> Tədbirlər</a></li>
                        <li class="nav-item"><a class="nav-link text-white active" asp-area="Admin" asp-controller="News" asp-action="Index"><i class="fas fa-newspaper"></i> Xəbərlər</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-area="Admin" asp-controller="Teacher" asp-action="Index"><i class="fas fa-chalkboard-teacher"></i> Müəllimlər</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-area="Admin" asp-controller="Icon" asp-action="Index"><i class="fas fa-icons"></i> İconlar</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-area="Admin" asp-controller="Setting" asp-action="Index"><i class="fas fa-cog"></i> Tənzimləmələr</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="/"><i class="fas fa-globe"></i> Sayta Get</a></li>
                    </ul></div></nav>
            <main class="col-md-10 ms-sm-auto px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Xəbər Redaktə Et</h1><a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Geriyə</a></div>
                <div class="row"><div class="col-md-8"><form asp-action="Update" method="post" enctype="multipart/form-data">
                            <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="ExistingImage" />
                            <div class="mb-3"><label asp-for="Date" class="form-label">Tarix</label><input asp-for="Date" class="form-control" /><span asp-validation-for="Date" class="text-danger"></span></div>
                            <div class="mb-3"><label asp-for="Description" class="form-label">Açıqlama</label><textarea asp-for="Description" class="form-control" rows="4"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
                            @if (!string.IsNullOrEmpty(Model.ExistingImage))
                            {<div class="mb-3"><label class="form-label">Mövcud Şəkil</label><div><img src="~/images/@Model.ExistingImage" alt="Existing" style="width: 200px; height: 120px; object-fit: cover; border-radius: 5px;"></div></div>}
                            <div class="mb-3"><label asp-for="Image" class="form-label">Yeni Şəkil (ixtiyari)</label><input asp-for="Image" type="file" class="form-control" accept="image/*" /><span asp-validation-for="Image" class="text-danger"></span><small class="text-muted">Yeni şəkil seçməsəniz, mövcud şəkil saxlanacaq</small></div>
                            <div class="mb-3"><button type="submit" class="btn btn-warning"><i class="fas fa-save"></i> Yenilə</button>
                                <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-times"></i> Ləğv Et</a></div>
                        </form></div></div>
            </main></div></div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script></body></html>
