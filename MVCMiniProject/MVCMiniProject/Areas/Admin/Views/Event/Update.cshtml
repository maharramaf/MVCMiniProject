@model EventUpdateVM

@{
    ViewData["Title"] = "Tədbir Redaktə";
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 d-md-block bg-dark sidebar vh-100">
                <div class="position-sticky pt-3">
                    <h4 class="text-white text-center mb-4">Admin Panel</h4>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                <i class="fas fa-home"></i> Ana Səhifə
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="Admin" asp-controller="Slider" asp-action="Index">
                                <i class="fas fa-images"></i> Sliderlər
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="Admin" asp-controller="Course" asp-action="Index">
                                <i class="fas fa-book"></i> Kurslar
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white active" asp-area="Admin" asp-controller="Event" asp-action="Index">
                                <i class="fas fa-calendar"></i> Tədbirlər
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/">
                                <i class="fas fa-globe"></i> Sayta Get
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <main class="col-md-10 ms-sm-auto px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Tədbir Redaktə Et</h1>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Geriyə
                    </a>
                </div>

                <div class="row">
                    <div class="col-md-8">
                        <form asp-action="Update" method="post">
                            <input type="hidden" asp-for="Id" />

                            <div class="mb-3">
                                <label asp-for="Title" class="form-label">Başlıq</label>
                                <input asp-for="Title" class="form-control" />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">Açıqlama</label>
                                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Date" class="form-label">Tarix (Gün)</label>
                                    <input asp-for="Date" type="number" min="1" max="31" class="form-control" />
                                    <span asp-validation-for="Date" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="Month" class="form-label">Ay</label>
                                    <select asp-for="Month" class="form-select">
                                        <option value="">Seçin...</option>
                                        <option value="Yanvar">Yanvar</option>
                                        <option value="Fevral">Fevral</option>
                                        <option value="Mart">Mart</option>
                                        <option value="Aprel">Aprel</option>
                                        <option value="May">May</option>
                                        <option value="İyun">İyun</option>
                                        <option value="İyul">İyul</option>
                                        <option value="Avqust">Avqust</option>
                                        <option value="Sentyabr">Sentyabr</option>
                                        <option value="Oktyabr">Oktyabr</option>
                                        <option value="Noyabr">Noyabr</option>
                                        <option value="Dekabr">Dekabr</option>
                                    </select>
                                    <span asp-validation-for="Month" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <button type="submit" class="btn btn-warning">
                                    <i class="fas fa-save"></i> Yenilə
                                </button>
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="fas fa-times"></i> Ləğv Et
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
